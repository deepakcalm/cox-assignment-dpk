# ---- Customer side (your own harness page; full e2e) ----
# Glance group id + site from YOUR Glance account (trial or company tenant)
GLANCE_GROUP_ID=12345
GLANCE_SITE=staging
HARNESS_PORT=4400

# ---- Agent side ----
# {key} is replaced with the 4-digit session key. Confirm the exact join URL
# for your tenant in the Glance admin / agent docs (Panorama vs classic viewer).
GLANCE_AGENT_JOIN_URL=https://www.glance.net/agentjoin/AgentView.aspx?SessionKey={key}&Wait=1
# Saved by `npm run agent:login` (log in once manually, handles SSO/MFA)
AGENT_STORAGE_STATE=.auth/agent.json

# ---- US Bank smoke (customer side only) ----
USBANK_URL=https://www.usbank.com/
