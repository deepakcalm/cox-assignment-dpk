{
  "name": "e2e-cobrowse",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright e2e for Glance CoBrowse: customer generates 4-digit key, agent joins, PII stays masked.",
  "scripts": {
    "harness": "node harness/server.mjs",
    "agent:login": "playwright codegen --save-storage=.auth/agent.json https://www.glance.net/login",
    "test": "playwright test",
    "test:harness": "playwright test --project=harness",
    "test:wiring": "playwright test harness-wiring",
    "test:usbank": "playwright test --project=usbank-smoke",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.2",
    "dotenv": "16.4.7",
    "typescript": "5.6.3"
  }
}
